# Patterns deliberately UNANCHORED, so that they bite at every level.
# Canonical inputs and generators stay tracked; reproducible outputs do not.
# uv.lock and .python-version are tracked on purpose.

__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.eggs/

# Tool caches and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment and state
.env
.env.*
!.env.example
*.log

# Editor and operating system
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100/
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
.fuse_hidden*
.directory
.Trash-*
.nfs*
.idea/
.vscode/
*.swp
*.swo
*~
